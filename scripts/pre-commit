#!/bin/bash

set -euo pipefail

RAW_DATE="$(date "+%Y-%m-%dT%H:%M:%S%z")"
DATE_LENGTH=${#RAW_DATE}
CURRENT_DATE="${RAW_DATE:0:DATE_LENGTH-2}:${RAW_DATE:DATE_LENGTH-2:2}"
TEMP_FILE="$(mktemp "${TMPDIR:-/tmp}/alexn-pre-commit.XXXXXX")"
trap 'rm -f "$TEMP_FILE"' EXIT

while IFS= read -r -d '' FILE; do
    [ -f "$FILE" ] || continue

    awk -v current_date="$CURRENT_DATE" '
        NR == 1 && $0 == "---" {
            in_frontmatter = 1
            print
            next
        }

        in_frontmatter && $0 == "---" {
            in_frontmatter = 0
            print
            next
        }

        in_frontmatter && /^date:[[:space:]]*$/ {
            print "date: " current_date
            next
        }

        in_frontmatter && /^last_modified_at:/ {
            print "last_modified_at: " current_date
            next
        }

        { print }
    ' "$FILE" > "$TEMP_FILE"

    if ! cmp -s "$FILE" "$TEMP_FILE"; then
        cat "$TEMP_FILE" > "$FILE"
        git add -- "$FILE"
        echo "Updated frontmatter timestamps in $FILE"
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
